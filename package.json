{
  "name": "ninepatch-vue",
  "version": "2.0.0",
  "description": "Vue component that renders Android nine-patch images",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/midi-zeng/ninepatch-vue.git"
  },
  "author": "midi_zeng <zengfukun@foxmail.com>",
  "maintainers": [
    "midi_zeng"
  ],
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "ninepatch-core": "^2.0.0"
  },
  "peerDependencies": {
    "vue": "^3.2"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.1.8"
  }
}
